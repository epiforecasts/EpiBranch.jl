# Normalise line endings so checkouts are byte-identical across platforms. A
# Windows runner with core.autocrlf checks out CRLF sources, and the formatter
# check in `test/test_quality.jl` then reports differences that exist only on
# that runner.
* text=auto eol=lf

# Binary files: never normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Every pull request appends under the same heading, so two of them conflict on
# entries that do not disagree. Union takes both sides' lines instead.
#
# It never reports a conflict, and that costs something at release time. A
# release empties `## [Unreleased]`; a branch that merges main afterwards takes
# the lines from both sides, so the emptied entries come back under that heading
# with a clean merge and no warning. After merging a release into an open
# branch, read that section before pushing.
CHANGELOG.md merge=union
